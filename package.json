{
  "name": "monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "e2e": "ng e2e",
    "version": "nest --version",
    "cn-space-api:serve": "nest start cn-space-api --debug --watch",
    "cn-space-api:build": "nest build cn-space-api",
    "cn-space-api:serve-prod": "node dist/cn-main",
    "cn-space-api:test": "jest --config ./apps/cn-space-api/jest.config.ts",
    "cn-space-api:test-e2e": "cross-env ENVIRONMENT_PROFILE=test jest --config ./apps/cn-space-api/test/jest-e2e.json",
    "cn-space-api:test-all": "bun run cn-space-api:test && bun run cn-space-api:test-e2e",
    "cn-space-api:caprover-deploy-preprod": "node deploy.mjs https://captain.constellab-pre-prod.gencovery.com space-api-pre-prod ghcr.io/constellab/space-api cn_",
    "cn-space-api:caprover-deploy-prod": "node deploy.mjs https://captain.constellab.gencovery.com space-api ghcr.io/constellab/space-api cn_",
    "cn-space-api:build-image": "docker build -f apps/cn-space-api/Dockerfile -t cn-space-api .",
    "hn-community-api:serve": "nest start hn-community-api --debug --watch",
    "hn-community-api:build": "nest build hn-community-api",
    "hn-community-api:test": "jest --config ./apps/hn-community-api/jest.config.ts",
    "hn-community-api:test-e2e": "cross-env ENVIRONMENT_PROFILE=test jest --config ./apps/hn-community-api/test/jest-e2e.json",
    "hn-community-api:test-all": "bun run hn-community-api:test && bun run hn-community-api:test-e2e",
    "hn-community-api:caprover-deploy-pre-prod": "node deploy.mjs https://captain.constellab-pre-prod.gencovery.com community-api-pre-prod ghcr.io/constellab/community-api hn_",
    "hn-community-api:caprover-deploy-prod": "node deploy.mjs https://captain.constellab.gencovery.com community-api ghcr.io/constellab/community-api hn_",
    "hn-community-api:build-image": "docker build -f apps/hn-community-api/Dockerfile -t hn-community-api .",
    "te-text-editor:test": "jest --config ./libs/te-text-editor/jest.config.ts",
    "back-core-lib:test": "jest --config ./libs/back-core-lib/jest.config.ts"
  },
  "private": true,
