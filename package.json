  "scripts": {
    "ng": "nx",
    "postinstall": "node ./decorate-angular-cli.js && ngcc --properties es2015 browser module main --first-only --create-ivy-entry-points",
    "nx": "nx",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "nx workspace-lint && ng lint",
    "e2e": "ng e2e",
    "affected:apps": "nx affected:apps",
    "affected:libs": "nx affected:libs",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "affected:dep-graph": "nx affected:dep-graph",
    "affected": "nx affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "workspace-generator": "nx workspace-generator",
    "dep-graph": "nx dep-graph",
    "help": "nx help",
    "central-front:serve": "nx serve central-front",
    "central-front:build-prod": "nx build central-front --prod",
    "central-front:build-pre-prod": "nx build central-front --configuration=preprod",
    "central-front:build-dev": "nx build central-front --configuration=dev",
    "central-front:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName central-front-pre-prod --branch develop",
    "central-front:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName central-front --branch master",
    "central-front:build-stats": "nx build central-front --prod --stats-json && npm run central-front:view-stats",
    "central-front:view-stats": "webpack-bundle-analyzer.cmd dist/apps/central-front/stats.json",
    "central-front:build-image-dev": "docker build -f apps/central-front/Dockerfile -t central-front --build-arg ENVIRONMENT_PROFILE=dev .",
    "central-front:lint": "nx run central-front:lint",
    "lab-front:serve": "nx serve lab-front",
    "lab-front:build-prod": "nx build lab-front --prod",
    "lab-front:build-dev": "nx build lab-front --configuration=dev",
    "lab-front:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName pre-prod-lab-front --branch master",
    "lab-front:build-stats": "nx build lab-front --prod --stats-json && npm run lab-front:view-stats",
    "lab-front:view-stats": "webpack-bundle-analyzer.cmd dist/apps/lab-front/stats.json",
    "lab-front:lint": "nx run lab-front:lint",
    "cn-central-back:serve": "nx run cn-central-back:serve",
    "cn-central-back:build": "nx run cn-central-back:build",
    "cn-central-back:serve-prod": "node dist/main",
    "cn-central-back:test-e2e": "set ENVIRONMENT_PROFILE=test&& set DATABASE=gencoveryDbTest&& jest --config ./apps/cn-central-back/test/jest-e2e.json",
    "cn-central-back:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName cn-central-back-pre-prod --branch develop",
    "cn-central-back:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName cn-central-back --branch master",
    "cn-central-back:lint": "nx run cn-central-back:lint",
    "cn-central-back:build-image-dev": "docker build -f apps/cn-central-back/Dockerfile -t cn-central-back .",
    "da-documentation:serve": "nx serve da-documentation",
    "da-documentation:build-prod": "nx build da-documentation --prod",
    "da-documentation:build-pre-prod": "nx build da-documentation --configuration=preprod",
    "da-documentation:build-dev": "nx build da-documentation --configuration=dev",
    "da-documentation:build-image-dev": "docker build -f apps/da-documentation/Dockerfile -t da-documentation .",
    "da-documentation:caprover-deploy-pre-prod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName hub-front-pre-prod --branch develop",
    "da-documentation:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName hub-front --branch master",
    "dn-documentation:serve": "nx run dn-documentation:serve",
    "dn-documentation:build": "nx run dn-documentation:build",
    "dn-documentation:build-image-dev": "docker build -f apps/dn-documentation/Dockerfile -t dn-documentation .",
    "dn-documentation:caprover-deploy-pre-prod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName hub-back-pre-prod --branch develop",
    "dn-documentation:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com/ --appName hub-back --branch master"
  },
