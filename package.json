    "help": "nx help",
    "ca-central-front:serve": "nx serve ca-central-front",
    "ca-central-front:build-prod": "nx build ca-central-front --prod",
    "ca-central-front:build-pre-prod": "nx build ca-central-front --configuration=preprod",
    "ca-central-front:build-dev": "nx build ca-central-front --configuration=devevelopment",
    "ca-central-front:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName central-front-pre-prod --branch develop",
    "ca-central-front:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName central-front --branch master",
    "ca-central-front:build-stats": "nx build ca-central-front --prod --stats-json && npm run ca-central-front:view-stats",
    "ca-central-front:view-stats": "webpack-bundle-analyzer.cmd dist/apps/ca-central-front/stats.json",
    "ca-central-front:build-image-dev": "docker build -f apps/ca-central-front/Dockerfile -t ca-central-front --build-arg ENVIRONMENT_PROFILE=dev .",
    "ca-central-front:lint": "nx run ca-central-front:lint",
    "lab-front:serve": "nx serve lab-front",
    "lab-front:build-prod": "nx build lab-front --prod",
    "lab-front:build-dev": "nx build lab-front --configuration=devevelopment",
    "lab-front:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName pre-prod-lab-front --branch master",
    "lab-front:build-stats": "nx build lab-front --prod --stats-json && npm run lab-front:view-stats",
    "lab-front:view-stats": "webpack-bundle-analyzer.cmd dist/apps/lab-front/stats.json",
    "lab-front:lint": "nx run lab-front:lint",
    "cn-central-back:serve": "nx run cn-central-back:serve",
    "cn-central-back:build": "nx run cn-central-back:build",
    "cn-central-back:serve-prod": "node dist/main",
    "cn-central-back:test-e2e": "set ENVIRONMENT_PROFILE=test&& set DATABASE=gencoveryDbTest&& jest --config ./apps/cn-central-back/test/jest-e2e.json",
    "cn-central-back:caprover-deploy-preprod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName central-back-pre-prod --branch develop",
    "cn-central-back:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName central-back --branch master",
    "cn-central-back:lint": "nx run cn-central-back:lint",
    "cn-central-back:build-image-dev": "docker build -f apps/cn-central-back/Dockerfile -t cn-central-back .",
    "ha-hub:serve": "nx serve ha-hub",
    "ha-hub:build-prod": "nx build ha-hub --prod",
    "ha-hub:build-pre-prod": "nx build ha-hub --configuration=preprod",
    "ha-hub:build-dev": "nx build ha-hub --configuration=devevelopment",
    "ha-hub:build-image-dev": "docker build -f apps/ha-hub/Dockerfile -t ha-hub .",
    "ha-hub:caprover-deploy-pre-prod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName hub-front-pre-prod --branch develop",
    "ha-hub:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName hub-front --branch master",
    "hn-hub:serve": "nx run hn-hub:serve",
    "hn-hub:build": "nx run hn-hub:build",
    "hn-hub:build-image-dev": "docker build -f apps/hn-hub/Dockerfile -t hn-hub .",
    "hn-hub:caprover-deploy-pre-prod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName hub-back-pre-prod --branch develop",
    "hn-hub:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com/ --appName hub-back --branch master"
  },
