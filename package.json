    "ha-hub:build-prod": "nx build ha-hub --prod",
    "ha-hub:build-pre-prod": "nx build ha-hub --configuration=preprod",
    "ha-hub:build-dev": "nx build ha-hub --configuration=devevelopment",
    "ha-hub:build-image-dev": "docker build -f apps/ha-hub/Dockerfile -t ha-hub .",
    "ha-hub:caprover-deploy-pre-prod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName hub-front-pre-prod --branch develop",
    "ha-hub:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com --appName hub-front --branch master",
    "hn-hub:serve": "nx run hn-hub:serve",
    "hn-hub:build": "nx run hn-hub:build",
    "hn-hub:build-image-dev": "docker build -f apps/hn-hub/Dockerfile -t hn-hub .",
    "hn-hub:caprover-deploy-pre-prod": "caprover deploy --host https://captain.constellab-pre-prod.gencovery.com --appName hub-back-pre-prod --branch develop",
    "hn-hub:caprover-deploy-prod": "caprover deploy --host https://captain.constellab.gencovery.com/ --appName hub-back --branch master"
