{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "jsc": {
    "target": "es2021",
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "keepClassNames": true,
    "baseUrl": ".",
    "paths": {
      "@monorepo/back-core-lib": ["libs/back-core-lib/src/index.ts"],
      "@monorepo/core-lib": ["libs/core-lib/src/index.ts"],
      "@monorepo/te-text-editor": ["libs/te-text-editor/src/index.ts"]
    }
  },
  "module": {
    "type": "commonjs"
  }
}
