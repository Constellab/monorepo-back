{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    // Deprecated, removed in TS 7.
    "moduleResolution": "node10",
    "ignoreDeprecations": "5.0",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2023",
    "module": "esnext",
    "lib": ["es2023", "dom"],
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    // Deprecated, removed in TS 7.
    "baseUrl": ".",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@monorepo/back-core-lib": ["libs/back-core-lib/src/index.ts"],
      "@monorepo/core-lib": ["libs/core-lib/src/index.ts"],
      "@monorepo/te-text-editor": ["libs/te-text-editor/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
