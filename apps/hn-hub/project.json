{
  "name": "hn-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/hn-hub/src",
  "projectType": "application",
  "tags": [
    "back"
  ],
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": [
        "build"
      ],
      "options": {
        "buildTarget": "hn-hub:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "hn-hub:build:development"
        },
        "production": {
          "buildTarget": "hn-hub:build:production"
        }
      }
    }
  }
}
