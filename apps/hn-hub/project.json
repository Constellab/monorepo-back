{
  "root": "apps/hn-hub",
  "sourceRoot": "apps/hn-hub/src",
  "projectType": "application",
  "prefix": "hn-hub",
  "architect": {
    "build": {
      "builder": "@nrwl/node:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/hn-hub",
        "main": "apps/hn-hub/src/main.ts",
        "tsConfig": "apps/hn-hub/tsconfig.app.json",
        "assets": [
          "apps/hn-hub/src/assets",
          "apps/hn-hub/src/environments"
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/hn-hub/src/environments/environment.ts",
              "with": "apps/hn-hub/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "builder": "@nrwl/node:execute",
      "options": {
        "buildTarget": "hn-hub:build"
      }
    },
    "lint": {
      "builder": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/hn-hub/**/*.ts"
        ]
      }
    },
    "test": {
      "builder": "@nrwl/jest:jest",
      "outputs": [
        "coverage/apps/hn-hub"
      ],
      "options": {
        "jestConfig": "apps/hn-hub/jest.config.js",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["back"]
}
