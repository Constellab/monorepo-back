{
  "name": "ha-hub",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ha-hub/src",
  "prefix": "ha",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "outputPath": "dist/apps/ha-hub",
        "index": "apps/ha-hub/src/index.html",
        "main": "apps/ha-hub/src/main.ts",
        "polyfills": "apps/ha-hub/src/polyfills.ts",
        "tsConfig": "apps/ha-hub/tsconfig.app.json",
        "assets": [
          "apps/ha-hub/src/assets",
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/font"
          }
        ],
        "styles": [
          "apps/ha-hub/src/ha-styles.scss",
          {
            "input": "apps/ha-hub/src/theme/ha-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/ha-hub/src/theme/ha-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": ["quill", "luxon", "lodash.throttle"]
      },
      "configurations": {
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ]
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/ha-hub/src/environments/ha-environment.ts",
              "with": "apps/ha-hub/src/environments/ha-environment.prod.ts"
            }
          ],
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "serviceWorker": true,
          "outputHashing": "all",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        },
        "preprod": {
          "fileReplacements": [
            {
              "replace": "apps/ha-hub/src/environments/ha-environment.ts",
              "with": "apps/ha-hub/src/environments/ha-environment.preprod.ts"
            }
          ],
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "serviceWorker": true,
          "outputHashing": "all",
          "ngswConfigPath": "apps/ha-hub/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "10kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "browserTarget": "ha-hub:build"
      },
      "configurations": {
        "production": {
          "browserTarget": "ha-hub:build:production"
        },
        "development": {
          "browserTarget": "ha-hub:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "ha-hub:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/ha-hub/src/**/*.ts",
          "apps/ha-hub/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/ha-hub"],
      "options": {
        "jestConfig": "apps/ha-hub/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["front"]
}
