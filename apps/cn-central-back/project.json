{
  "root": "apps/cn-central-back",
  "sourceRoot": "apps/cn-central-back/src",
  "projectType": "application",
  "prefix": "cn-central-back",
  "targets": {
    "build": {
      "executor": "@nrwl/node:build",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/cn-central-back",
        "main": "apps/cn-central-back/src/main.ts",
        "tsConfig": "apps/cn-central-back/tsconfig.app.json",
        "assets": [
          "apps/cn-central-back/src/assets",
          "apps/cn-central-back/src/environments"
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "@nrwl/node:execute",
      "options": {
        "buildTarget": "cn-central-back:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["apps/cn-central-back/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/cn-central-back"],
      "options": {
        "jestConfig": "apps/cn-central-back/jest.config.js",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["back"]
}
