{
  "name": "cn-central-back",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/cn-central-back/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/node:webpack",
      "outputs": ["{options.outputPath}"],
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/cn-central-back",
        "main": "apps/cn-central-back/src/main.ts",
        "tsConfig": "apps/cn-central-back/tsconfig.app.json",
        "assets": [
          "apps/cn-central-back/src/assets",
          "apps/cn-central-back/src/environments"
        ]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false
        }
      }
    },
    "serve": {
      "executor": "@nrwl/js:node",
      "options": {
        "buildTarget": "cn-central-back:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/cn-central-back/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/cn-central-back"],
      "options": {
        "jestConfig": "apps/cn-central-back/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["back"]
}
