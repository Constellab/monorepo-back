ENVIRONMENT_PROFILE=test

# Domains allowed to call this API cross-origin, comma-separated. Each entry allows the
# domain itself and any of its sub-domains over https. Ignored in a local profile (dev,
# docker, test), where every origin is accepted; required everywhere else, or the process
# stops at startup.
CORS_ALLOWED_DOMAINS=constellab.community,constellab.space,preconstellab.com,gencovery.com,gencovery.io,constellab.app

# Logging
LOG_LEVEL=info
LOG_PATH=logs/hn-community-api

# Domain
DOMAIN=localhost

# Database config
# IMPORTANT: this MUST point at a throwaway database. The E2E test harness
# (HnTestDbInitializerService) DROPS and recreates this database on every run.
# Uses the dedicated 'community-test-db' docker container, NOT the dev DB.
DATABASE_HOST=localhost
DATABASE=testDb
DATABASE_PORT=3312
DATABASE_USER=gencoveryUser
DATABASE_PASSWORD=gencovery

# JWT
JWT_SECRET=dfTgd458z$rG*sT4dsfs%S75
OTHER_JWT_SECRET=jkjdfbg64*%df64Eg:zf4564?

FAILED_LOGIN_LOCK=10
API_URL=http://localhost:3333

# Fronts. Both are base URLs, with or without a trailing slash — the API strips it.
# FRONT_URL is this application's own front (the Community website); SPACE_FRONT_URL is
# the Space front, a different application, where a visitor is sent to log in.
FRONT_URL=http://localhost:4200
SPACE_FRONT_URL=http://localhost:4200

# OAuth 2.1 / MCP — nothing to configure, see hn-dev.env. The suite that covers the
# Resource Server substitutes the published key set rather than reaching a real Space
# API, since that is a different application and no e2e run boots both.

CUSTOMER_SUCCESS_MAIL=clientsuccess@gencovery.com
SALES_MAIL=sales@gencovery.com
ROBOT_USER_MAIL=robot@gencovery.com

# SPACE
SPACE_API_URL=http://localhost:3001
SPACE_API_KEY=123456

# OBJECT STORAGE
OBJECT_STORAGE_DEFAULT_ACCESS_KEY_ID=
OBJECT_STORAGE_DEFAULT_SECRET_KEY=
OBJECT_STORAGE_DEFAULT_ENDPOINT=https://s3.sbg.io.cloud.ovh.net/
OBJECT_STORAGE_DEFAULT_REGION=sbg
OBJECT_STORAGE_BACKUP_ENDPOINT=https://s3.gra.io.cloud.ovh.net/
OBJECT_STORAGE_BACKUP_REGION=gra

# OBJECT STORAGE DB BACKUP
OBJECT_STORAGE_DB_BACKUP_ENDPOINT=https://s3.sbg.io.cloud.ovh.net/
OBJECT_STORAGE_DB_BACKUP_REGION=sbg

# BUCKETS
BUCKET_ICON=community-icon-local
BUCKET_ICON_BACKUP=community-icon-local-backup
BUCKET_DOCUMENTATION=community-documentation-local
BUCKET_DOCUMENTATION_BACKUP=community-documentation-local-backup
BUCKET_STORIES=community-stories-local
BUCKET_STORIES_BACKUP=community-stories-local-backup
BUCKET_AGENTS=community-live-task-local
BUCKET_AGENTS_BACKUP=community-live-task-local-backup
BUCKET_APPS=community-app-local
BUCKET_APPS_BACKUP=community-app-local-backup
BUCKET_PARTNERS=community-partners-local
BUCKET_PARTNERS_BACKUP=community-partners-local-backup

# Where the nightly database dump is written
BUCKET_DB_BACKUP=constellab-db-backup-pre-prod

# RABBITMQ
QUEUE_SERVICE_PASSWORD=
QUEUE_SERVICE_HOST=localhost
# 6380, not the dev 6379: the 'test-redis' container in compose.test.yml, so the test
# stack can run next to the dev one and no run touches the dev queue.
QUEUE_SERVICE_PORT=6380

# Mail Config
MAIL_HOST=localhost
MAIL_PORT=2500
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@gencovery.com

# Space
GENCOVERY_SPACE_ID=b4f3e866-7b96-4e55-93ca-03c353286ee5

# Ragflow
RAGFLOW_API_KEY=
RAGFLOW_BASE_URL=
RAGFLOW_CHAT_ID=
