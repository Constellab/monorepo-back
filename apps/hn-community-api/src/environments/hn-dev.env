ENVIRONMENT_PROFILE=dev

# Logging
LOG_LEVEL=info
LOG_PATH=logs/hn-community-api

# Domain
DOMAIN=localhost

# Database config
DATABASE_HOST=localhost
DATABASE=communityDb
DATABASE_PORT=3310
DATABASE_USER=gencoveryUser
DATABASE_PASSWORD=gencovery

# JWT
JWT_SECRET=COMMUNITY_SECRET
OTHER_JWT_SECRET=COMMUNITY_OTHER_SECRET

FAILED_LOGIN_LOCK=10  # Number of failed login attempt before locking the account
API_URL=http://localhost:3333

# Session token lifetimes, in seconds. All optional — the defaults in
# hn-jwt.config.ts apply when unset (access 900 = 15 min, refresh 30 days,
# MCP access 3600 = 1 h).
# ACCESS_TOKEN_DURATION_SECONDS=900
# REFRESH_TOKEN_DURATION_SECONDS=2592000
# MCP_ACCESS_TOKEN_DURATION_SECONDS=3600

# OAuth 2.1 / MCP
# Non-loopback redirect URIs an OAuth client may register, comma-separated, matched
# exactly (scheme, host, port, path, query).
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Key that signs MCP access tokens: a base64-encoded PEM RSA private key (RS256). Its
# public half is published at /.well-known/jwks.json, which is how a resource server in
# another application verifies a token without being able to mint one. Deliberately NOT
# JWT_SECRET — that one signs session tokens and never leaves this application.
#
# Base64 because PEM is multi-line and environment variables lose the newlines. Generate
# one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
#
# Throwaway local key, valid for nothing outside a dev machine. Real environments get
# their own, supplied as configuration and never committed.
MCP_JWT_PRIVATE_KEY_

# During a key rotation only: the key being retired. Published in the key set and still
# accepted, but never signs again, so tokens minted before the rotation keep working
# until they expire. Remove it on the next deployment. Must not repeat the value above.
# MCP_JWT_PREVIOUS_PRIVATE_KEY_BASE64=

CUSTOMER_SUCCESS_MAIL=clientsuccess@gencovery.com
SALES_MAIL=sales@gencovery.com
ROBOT_USER_MAIL=robot@gencovery.com


#SPACE
SPACE_API_URL=https://api.preconstellab.com
SPACE_API_KEY=123456


#OBJECT STORAGE
OBJECT_STORAGE_DEFAULT_ACCESS_KEY_ID=ce7e6d93a1f6400fb4c19b3aebaf2547
OBJECT_STORAGE_DEFAULT_SECRET_KEY=04c55d337299410c9858043ede58b717
OBJECT_STORAGE_DEFAULT_ENDPOINT=https://s3.sbg.io.cloud.ovh.net/
OBJECT_STORAGE_DEFAULT_REGION=sbg
