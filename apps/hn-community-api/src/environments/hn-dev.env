ENVIRONMENT_PROFILE=dev

# Logging
LOG_LEVEL=info
LOG_PATH=logs/hn-community-api

# Domain
DOMAIN=localhost

# Database config
DATABASE_HOST=localhost
DATABASE=communityDb
DATABASE_PORT=3310
DATABASE_USER=gencoveryUser
DATABASE_PASSWORD=gencovery

# JWT
JWT_SECRET=COMMUNITY_SECRET
OTHER_JWT_SECRET=COMMUNITY_OTHER_SECRET

FAILED_LOGIN_LOCK=10  # Number of failed login attempt before locking the account
API_URL=http://localhost:3333

# Session token lifetimes, in seconds. Both optional — the defaults in
# hn-jwt.config.ts apply when unset (access 900 = 15 min, refresh 30 days).
# ACCESS_TOKEN_DURATION_SECONDS=900
# REFRESH_TOKEN_DURATION_SECONDS=2592000

# OAuth 2.1 / MCP
# Nothing to configure. This application is a Resource Server only: it verifies MCP
# access tokens against the key set the Space API publishes and mints none of its own,
# so it holds no signing key, no redirect allowlist and no token lifetime. The one value
# it needs is SPACE_API_URL below, which names the single Authorization Server.

CUSTOMER_SUCCESS_MAIL=clientsuccess@gencovery.com
SALES_MAIL=sales@gencovery.com
ROBOT_USER_MAIL=robot@gencovery.com


#SPACE
SPACE_API_URL=https://api.preconstellab.com
SPACE_API_KEY=123456


#OBJECT STORAGE
OBJECT_STORAGE_DEFAULT_ACCESS_KEY_ID=ce7e6d93a1f6400fb4c19b3aebaf2547
OBJECT_STORAGE_DEFAULT_SECRET_KEY=04c55d337299410c9858043ede58b717
OBJECT_STORAGE_DEFAULT_ENDPOINT=https://s3.sbg.io.cloud.ovh.net/
OBJECT_STORAGE_DEFAULT_REGION=sbg
OBJECT_STORAGE_BACKUP_ENDPOINT=https://s3.gra.io.cloud.ovh.net/
OBJECT_STORAGE_BACKUP_REGION=gra

# OBJECT STORAGE DB BACKUP
OBJECT_STORAGE_DB_BACKUP_ENDPOINT=https://s3.sbg.io.cloud.ovh.net/
OBJECT_STORAGE_DB_BACKUP_REGION=sbg

#BUCKETS
BUCKET_ICON=community-icon-local
BUCKET_ICON_BACKUP=community-icon-local-backup
BUCKET_DOCUMENTATION=community-documentation-local
BUCKET_DOCUMENTATION_BACKUP=community-documentation-local-backup
BUCKET_STORIES=community-stories-local
BUCKET_STORIES_BACKUP=community-stories-local-backup
BUCKET_AGENTS=community-live-task-local
BUCKET_AGENTS_BACKUP=community-live-task-local-backup
BUCKET_APPS=community-app-local
BUCKET_APPS_BACKUP=community-app-local-backup
BUCKET_PARTNERS=community-partners-local
BUCKET_PARTNERS_BACKUP=community-partners-local-backup

# RABBIMQ
QUEUE_SERVICE_PASSWORD=
QUEUE_SERVICE_HOST=localhost
QUEUE_SERVICE_PORT=6379


# Mail Config
# In local it uses mailslurper with the default docker config https://hub.docker.com/r/marcopas/docker-mailslurper/
MAIL_HOST=localhost
MAIL_PORT=2500
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@gencovery.com

# Space
GENCOVERY_SPACE_ID=b4f3e866-7b96-4e55-93ca-03c353286ee5

# Ragflow
RAGFLOW_API_KEY=
RAGFLOW_BASE_URL=
RAGFLOW_CHAT_ID=

