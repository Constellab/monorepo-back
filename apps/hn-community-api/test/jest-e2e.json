{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e.spec.ts$",
  "//": "Serial: every suite drops and re-synchronizes the SAME test database in beforeAll, so two running in parallel would tear down each other's schema mid-test.",
  "maxWorkers": 1,
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^jsdom$": "<rootDir>/stubs/jsdom.stub.ts",
    "^@monorepo/core-lib$": "<rootDir>/../../../libs/core-lib/src/index.ts",
    "^@monorepo/back-core-lib$": "<rootDir>/../../../libs/back-core-lib/src/index.ts",
    "^@monorepo/te-text-editor$": "<rootDir>/../../../libs/te-text-editor/src/index.ts"
  }
}
