{
  "root": "apps/ca-central-front-e2e",
  "sourceRoot": "apps/ca-central-front-e2e/src",
  "projectType": "application",
  "architect": {
    "e2e": {
      "builder": "@nrwl/cypress:cypress",
      "options": {
        "cypressConfig": "apps/ca-central-front-e2e/cypress.json",
        "tsConfig": "apps/ca-central-front-e2e/tsconfig.e2e.json",
        "devServerTarget": "ca-central-front:serve"
      },
      "configurations": {
        "production": {
          "devServerTarget": "ca-central-front:serve:production"
        }
      }
    },
    "lint": {
      "builder": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/ca-central-front-e2e/**/*.{js,ts}"
        ]
      }
    }
  }
}
