{
  "name": "ca-central-front",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/ca-central-front/src",
  "prefix": "ca",
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "options": {
        "outputPath": "dist/apps/ca-central-front",
        "index": "apps/ca-central-front/src/index.html",
        "main": "apps/ca-central-front/src/main.ts",
        "polyfills": "apps/ca-central-front/src/polyfills.ts",
        "tsConfig": "apps/ca-central-front/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/ca-central-front/src/assets",
          "apps/ca-central-front/src/manifest.webmanifest",
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/mat-icons",
            "output": "assets/fl-mat-icons"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/logo",
            "output": "assets/fl-logo"
          },
          {
            "glob": "**/*",
            "input": "libs/front-core-lib/src/assets/font",
            "output": "assets/fl-font"
          }
        ],
        "styles": [
          "apps/ca-central-front/src/ca-styles.scss",
          {
            "input": "apps/ca-central-front/src/theme/ca-light-theme.scss",
            "bundleName": "light-theme",
            "inject": false
          },
          {
            "input": "apps/ca-central-front/src/theme/ca-dark-theme.scss",
            "bundleName": "dark-theme",
            "inject": false
          }
        ],
        "scripts": [],
        "allowedCommonJsDependencies": [
          "class-transformer",
          "highlight.js",
          "quill",
          "drawflow",
          "luxon",
          "lodash.throttle"
        ]
      },
      "configurations": {
        "development": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true,
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ]
        },
        "production": {
          "serviceWorker": false,
          "outputHashing": "all",
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "fileReplacements": [
            {
              "replace": "apps/ca-central-front/src/environments/ca-environment.ts",
              "with": "apps/ca-central-front/src/environments/ca-environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ]
        },
        "preprod": {
          "serviceWorker": false,
          "outputHashing": "all",
          "optimization": {
            "styles": {
              "inlineCritical": false
            }
          },
          "fileReplacements": [
            {
              "replace": "apps/ca-central-front/src/environments/ca-environment.ts",
              "with": "apps/ca-central-front/src/environments/ca-environment.preprod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb",
              "maximumError": "30kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "browserTarget": "ca-central-front:build"
      },
      "configurations": {
        "production": {
          "browserTarget": "ca-central-front:build:production"
        },
        "development": {
          "browserTarget": "ca-central-front:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "browserTarget": "ca-central-front:build"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "apps/ca-central-front/src/**/*.ts",
          "apps/ca-central-front/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/ca-central-front"],
      "options": {
        "jestConfig": "apps/ca-central-front/jest.config.ts",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["front"]
}
