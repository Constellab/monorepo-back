ENVIRONMENT_PROFILE=test

# Logging
LOG_LEVEL=info
LOG_PATH=logs/cn-space-api

# Database config
# IMPORTANT: this MUST point at a throwaway database. The E2E test harness
# (CnTestDbInitializerService) DROPS and recreates this database on every run.
# Uses the dedicated 'space-test-db' docker container, NOT the dev DB.
DATABASE_HOST=localhost
DATABASE=testDb
DATABASE_PORT=3311
DATABASE_USER=gencoveryUser
DATABASE_PASSWORD=gencovery

# JWT
JWT_SECRET=dfTgd458z$rG*sT4dsfs%S75
OTHER_JWT_SECRET=jkjdfbg64*%df64Eg:zf4564?

FAILED_LOGIN_LOCK=10  # Number of failed login attempt before locking the account
API_URL=http://localhost:3001
FRONT_DOMAIN=localhost:4200
COMMUNITY_FRONT_URL=https://constellab.community
COMMUNITY_API_URL=http://localhost:3333
COMMUNITY_API_KEY=123456

# Mail Config
MAIL_HOST=localhost
MAIL_PORT=2500
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_SENDER=no-reply@gencovery.com

# Email of the robot user
ROBOT_USER_MAIL=robot@gencovery.com
CUSTOMER_SUCCESS_MAIL=clientsuccess@gencovery.com
SUPPORT_MAIL=support@gencovery.com

# OBJECT STORAGE
OBJECT_STORAGE_DEFAULT_ACCESS_KEY_ID=
OBJECT_STORAGE_DEFAULT_SECRET_KEY=
OBJECT_STORAGE_DEFAULT_ENDPOINT=https://s3.sbg.cloud.ovh.net/
OBJECT_STORAGE_DEFAULT_REGION=SBG

# OBJECT STORAGE DB BACKUP
OBJECT_STORAGE_DB_BACKUP_ENDPOINT=https://s3.sbg.io.cloud.ovh.net/
OBJECT_STORAGE_DB_BACKUP_REGION=sbg

# QUEUE
QUEUE_SERVICE_PASSWORD=
QUEUE_SERVICE_HOST=localhost
QUEUE_SERVICE_PORT=6379

# Path for the main ssh private key
MAIN_SSH_PRIVATE_KEY_FILE_PATH=

# OVH
OVH_SERVICE_NAME=
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
OVH_SSH_KEY_NAME=

# AZURE
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_RESOURCE_GROUP=Test
AZURE_SSH_KEY_NAME=
AZURE_NETWORK=virtualNetwork1
AZURE_NETWORK_SUBNET=subnet1

# OUTSCALE
OUTSCALE_ACCESS_KEY_ID=
OUTSCALE_SECRET_KEY=
OUTSCALE_SECURITY_GROUP=
OUTSCALE_SSH_KEY_NAME=
OUTSCALE_SSH_PRIVATE_KEY_FILE_PATH=

# GCP
GCP_PROJECT_ID=gencovery-preprod
GCP_FIREWALL_TAG=constellab
GCP_SSH_PRIVATE_KEY_FILE_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# LAB CONFIGURER REPO
LAB_CONFIGURER_REPO_URL=https://github.com/Constellab/lab-configurer.git
LAB_CONFIGURER_REPO_BRANCH=develop

# Other
NEW_USER_NOTIF_RECEIVERS=test@gencovery.com
FOLDER_ID_TO_COPY_ON_SIGNUP=
REFLEX_ACCESS_TOKEN=1234567890
# Max duration to keep a running server in temporary status (not fully started)
STARTED_SERVER_TEMP_STATUS_MAX_DURATION_MINUTES=60

LAB_MANAGER_VERSION=2.8.0
LAB_MANAGER_STANDALONE_FRONT_VERSION=latest

# CAPTCHA
CAPTCHA_SITE_KEY=

# YOUTUBE
YOUTUBE_API_KEY=
YOUTUBE_TUTORIAL_PLAYLIST_ID=
