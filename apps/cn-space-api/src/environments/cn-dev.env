ENVIRONMENT_PROFILE=dev

# Domains allowed to call this API cross-origin, comma-separated. Each entry allows the
# domain itself and any of its sub-domains over https. Ignored in a local profile (dev,
# docker, test), where every origin is accepted; required everywhere else, or the process
# stops at startup.
CORS_ALLOWED_DOMAINS=constellab.space,preconstellab.com

# Logging
LOG_LEVEL=info
LOG_PATH=logs/cn-space-api

# Database config
DATABASE_HOST=localhost
DATABASE=spaceDb
DATABASE_PORT=3306
DATABASE_USER=gencoveryUser
DATABASE_PASSWORD=gencovery

# JWT
JWT_SECRET=SPACE_SECRET
OTHER_JWT_SECRET=OTHER_SPACE_SECRET

# Token lifetimes, in seconds. All optional — the defaults in cn-jwt.config.ts apply
# when unset (session access 900 = 15 min, refresh 30 days, MCP access 3600 = 1 h).
# ACCESS_TOKEN_DURATION_SECONDS=900
# REFRESH_TOKEN_DURATION_SECONDS=2592000
# MCP_ACCESS_TOKEN_DURATION_SECONDS=3600

FAILED_LOGIN_LOCK=10  # Number of failed login attempt before locking the account
API_URL=http://localhost:3001
FRONT_DOMAIN=localhost:4200
COMMUNITY_FRONT_URL=https://constellab.community
COMMUNITY_API_URL=http://localhost:3333
COMMUNITY_API_KEY=123456

# ############################################################################
# OAuth 2.1 / MCP — this application is the Authorization Server (ADR-0001).
#
# The two values below are REQUIRED and are read while Nest builds the injector, so a
# missing one stops the process at startup rather than turning into registrations or
# authorization requests being refused later with no obvious cause.
# ############################################################################

# Non-loopback redirect URIs an OAuth client may register, comma-separated, matched
# exactly (scheme, host, port, path, query). Loopback is always allowed on any port
# (RFC 8252) and does not belong here — that is what the CLI uses.
#
# Registration is open, so this list is the only thing stopping anyone from registering
# a client that collects an authorization code for a logged-in user.
#
# Unsetting the variable stops the application at startup. Leaving it blank does NOT — it
# means loopback-only, which is a valid CLI-only deployment; the application logs a warning
# on boot so a field blanked by accident is visible rather than showing up later as every
# browser client's registration being refused.
OAUTH_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback

# Key that signs MCP access tokens: a base64-encoded PEM RSA private key (RS256). Its
# public half is published at /.well-known/jwks.json, which is how the Community API
# verifies a token without being able to mint one. Deliberately NOT JWT_SECRET — that one
# signs Session tokens and never leaves this application.
#
# Base64 because PEM is multi-line and environment variables lose the newlines. Generate
# one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | base64 -w0
#
# Throwaway local key, valid for nothing outside a dev machine. Real environments get
# their own, supplied as configuration and never committed.
MCP_JWT_PRIVATE_KEY_

# During a key rotation only: the key being retired. Published in the key set and still
# accepted, but never signs again, so tokens minted before the rotation keep working
# until they expire. Remove it on the next deployment. Must not repeat the value above.
# MCP_JWT_PREVIOUS_PRIVATE_KEY_BASE64=

