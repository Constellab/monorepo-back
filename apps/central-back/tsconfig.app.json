{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],

    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitReturns": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./"
  },
  "exclude": ["**/*.spec.ts"],
  "include": ["**/*.ts"]
}
