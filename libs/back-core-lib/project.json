{
  "root": "libs/back-core-lib",
  "sourceRoot": "libs/back-core-lib/src",
  "projectType": "library",
  "architect": {
    "lint": {
      "builder": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": [
          "libs/back-core-lib/**/*.ts"
        ]
      }
    },
    "test": {
      "builder": "@nrwl/jest:jest",
      "outputs": [
        "coverage/libs/back-core-lib"
      ],
      "options": {
        "jestConfig": "libs/back-core-lib/jest.config.js",
        "passWithNoTests": true
      }
    }
  },
  "tags": ["back"]
}
