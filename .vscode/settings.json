{
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.preferences.importModuleSpecifier": "project-relative",
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "eslint.format.enable": true,
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "prettier.configPath": ".prettierrc",
  // --- Jest (native Test Explorer via Orta.vscode-jest) ---
  // One virtual folder per test suite so they all show in the Test Explorer.
  // The "*-e2e" folders point at test/jest-e2e.json and set
  // ENVIRONMENT_PROFILE=test via cross-env; they only pass with the local MySQL
  // test DB running (cn:3311 / hn:3312) — otherwise the suite errors at setup.
  "jest.runMode": "on-demand",
  "jest.virtualFolders": [
    {
      "name": "cn-space-api",
      "rootPath": "apps/cn-space-api",
      "jestCommandLine": "npx jest --config ./jest.config.ts"
    },
    {
      "name": "cn-space-api-e2e",
      "rootPath": "apps/cn-space-api",
      "jestCommandLine": "npx cross-env ENVIRONMENT_PROFILE=test jest --config ./test/jest-e2e.json"
    },
    {
      "name": "hn-community-api",
      "rootPath": "apps/hn-community-api",
      "jestCommandLine": "npx jest --config ./jest.config.ts"
    },
    {
      "name": "hn-community-api-e2e",
      "rootPath": "apps/hn-community-api",
      "jestCommandLine": "npx cross-env ENVIRONMENT_PROFILE=test jest --config ./test/jest-e2e.json"
    },
    {
      "name": "te-text-editor",
      "rootPath": "libs/te-text-editor",
      "jestCommandLine": "npx jest --config ./jest.config.ts"
    }
  ]
}